<!DOCTYPE html>
<html lang="en">
<head>
	<title><%= metadata.title %> | Kyanit</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<%- include('modules/mathjax') %>
	<%- include('modules/prismjs') %>

	<script type="module" src="/dist/js/entries/doc.entry.js" defer></script>

	<link rel="stylesheet" href="/dist/css/main.entry.css">
	<link rel="stylesheet" href="/dist/css/entries/note.entry.css">
</head>
<body>
	<%- include('partials/header') %>
	<% const absoluteDate = new Intl.DateTimeFormat('en-us', { month: 'long', day: 'numeric', year: 'numeric' }).format; %>

	<main>
		<div class="meta-data">
			<div class="title"><%= metadata.title %></div>
			<div class="details">
				<div class="authors">
					<div class="author">
						<span class="author-display">Kyanit</span>
					</div>
				</div>
				<div class="statistic">
					<span class="date">
						<span class="date-full">
							<% if(metadata.createdAt === metadata.updatedAt) { %>
								<%= new Date(metadata.createdAt).toLocaleString() %>
							<% } else { %>
								<%= new Date(metadata.updatedAt).toLocaleString() %>
							<% } %>
						</span>
						<span class="date-short">
							<% if(metadata.createdAt === metadata.updatedAt) { %>
								Published at <%= absoluteDate(new Date(metadata.createdAt)) %>
							<% } else { %>
								Updated at <%= absoluteDate(new Date(metadata.updatedAt)) %>
							<% } %>
						</span>
					</span>
				</div>
			</div>
			<% if(metadata.thumbnailURL) { %>
				<div class="thumbnail">
					<img src="<%- metadata.thumbnailURL %>"/>
				</div>
			<% } %>
		</div>
		<hr class="meta-content-separator">
		<section class="content markdown-document" id="note-panel"><%- htmlContent %></section>
	</main>
</body>
</html>