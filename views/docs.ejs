<!DOCTYPE html>
<html lang="en">
<head>
	<title>Documentations | Kyanit</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<link rel="stylesheet" href="/dist/css/main.entry.css">
	<link rel="stylesheet" href="/dist/css/entries/notes.entry.css">
</head>
<body>
	<%- include('partials/header') %>

	<main>
		<h1><span class="material-symbols-outlined">article</span> Documentations</h1>

		<div class="note-card-small-container">
			<% for(let i = 0; i < docs.length; i++) { %>
				<% const note = docs[i]; %>
				<div class="note-card-small">
					<a href="/docs/<%- note.docname %>" class="link"></a>
					<% if(note.thumbnailURL) { %>
						<div class="thumbnail">
							<img src="<%- note.thumbnailURL %>"/>
						</div>
					<% } %>
					<div class="meta-data">
						<div class="title"><%= note.title %></div>
						<div class="author">Kyanit</div>
						<div class="details">
							<span class="date"><%= $relativeTimeFormatter(note.createdAt) %></span>
						</div>
					</div>
				</div>
			<% } %>
		</div>
	</main>
</body>
</html>