<!DOCTYPE html>
<html>
<head>
	<meta name="color-scheme" content="dark light"/>
	<meta name="theme-color" content="#e4e4e7"/>
	<script src="/js/partials/header.js" defer></script>
	<link rel="stylesheet" href="/css/partials/header.css">

	<!-- MATERIAL SYMBOLS -->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" />
	<link
		rel="preload"
		href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
		as="font"
		type="font/woff2"
		crossorigin />
</head>
<body>
	<header>
		<ul id="top-navigation" data-search="false">
			<li class="action" id="open-sidebar" tabindex="0"><span class="material-symbols-outlined">menu</span></li>
			<li id="logo"><a href="/"><img src="/assets/header.svg" class="logo-wordmark" alt="KYANIT" height="24"><img src="/assets/header-logo.svg" class="logo-logo" alt="K" height="24"></a></li>
			<li id="search-wrapper">
				<span class="material-symbols-outlined">search</span>
				<input type="text" name="search" id="search-input" placeholder="Search" size="1"/>
				<span class="material-symbols-outlined" id="search-cancel">close</span>
				<span class="material-symbols-outlined" id="search-submit">search</span>
			</li>
			<li class="action" id="search-button"><span class="material-symbols-outlined">search</span></li>
			<% if (isLoggedIn) { %>
				<li class="action">
					<a href="/user/<%- username %>" class="profile">
						<button class="icon large secondary">
							<span class="material-symbols-outlined">person</span>
						</button>
					</a>
				</li>
			<% } else { %>
				<li class="action">
					<a href="/login" class="profile">
						<button class="small secondary">Log in</button>
					</a>
					<a href="/signup" class="profile">
						<button class="small">Sign up</button>
					</a>
				</li>
			<% } %>
		</ul>
	</header>
	<aside id="sidebar">
		<div id="close-sidebar"><span class="material-symbols-outlined">arrow_back</span> BACK</div>
		<ul class="sidebar-navigation">
			<li class="sidebar-item"><a href="/"><span class="material-symbols-outlined">home</span> <span class="label">Home</span></a></li>
			<li class="sidebar-item"><a href="/explore"><span class="material-symbols-outlined">explore</span> <span class="label">Explore</span></a>
				<ul class="sidebar-navigation">
					<li class="sidebar-item"><a href="/explore"><span class="material-symbols-outlined">trending_up</span> <span class="label">Trending</span></a>
						<li class="sidebar-item"><a href="/explore"><span class="material-symbols-outlined">shift</span> <span class="label">Top</span></a>
					<li class="sidebar-item"><a href="/explore"><span class="material-symbols-outlined">schedule</span> <span class="label">New</span></a>
					</ul>
			</li>
			<hr>
			<% if (isLoggedIn) { %>
				<li class="sidebar-item"><a href="/user/<%- username %>"><span class="material-symbols-outlined">account_box</span> <span class="label">Profile</span></a></li>
				<li class="sidebar-item"><a href="/create"><span class="material-symbols-outlined">add_notes</span> <span class="label">Start Writing</span></a></li>
				<li class="sidebar-item"><a href="/settings"><span class="material-symbols-outlined">settings</span> <span class="label">Settings</span></a></li>
				<hr>
			<% } %>
			<li class="sidebar-item"><a href="/docs"><span class="material-symbols-outlined">help</span> <span class="label">Help</span></a></li>
			<li class="sidebar-item redirect"><a href="https://github.com/zf-ran/kyanit"><span class="material-symbols-outlined">network_node</span> <span class="label">Version Control</span> <span class="material-symbols-outlined open-in-new">open_in_new</span></a></li>
			<li class="sidebar-item redirect"><a href="https://github.com/zf-ran/kyanit/issues"><span class="material-symbols-outlined">bug_report</span> <span class="label">Report Bug</span> <span class="material-symbols-outlined open-in-new">open_in_new</span></a></li>
		</ul>
		<div class="sidebar-footer">
			<div class="name"><%= version %></div>
		</div>
	</aside>
</body>
</html>