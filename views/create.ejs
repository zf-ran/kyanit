<!DOCTYPE html>
<html lang="en">
<head>
	<title>Create | Kyanit</title>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<script src="/js/create.mjs" type="module" defer></script>

	<link rel="stylesheet" href="/main.css">
	<link rel="stylesheet" href="/css/create.css">
</head>
<body>
	<%- include('partials/header') %>

	<main>
		<div class="toolbar">
			<button id="tool-h1"><span class="material-symbols-outlined">format_h1</span></button>
			<button id="tool-h2"><span class="material-symbols-outlined">format_h2</span></button>
			<button id="tool-h3"><span class="material-symbols-outlined">format_h3</span></button>
			<button id="tool-h4"><span class="material-symbols-outlined">format_h4</span></button>
			<button id="tool-h5"><span class="material-symbols-outlined">format_h5</span></button>
			<button id="tool-h6"><span class="material-symbols-outlined">format_h6</span></button>

			<hr class="toolbar-separator"/>

			<button id="tool-bold"><span class="material-symbols-outlined">format_bold</span></button>
			<button id="tool-italic"><span class="material-symbols-outlined">format_italic</span></button>
			<button id="tool-strikethrough"><span class="material-symbols-outlined">strikethrough_s</span></button>
			<button id="tool-codespan"><span class="material-symbols-outlined">code</span></button>
			<button id="tool-link"><span class="material-symbols-outlined">link</span></button>
			<button id="tool-inline-math"><span class="material-symbols-outlined">function</span></button>

			<hr class="toolbar-separator"/>

			<button id="tool-codeblock"><span class="material-symbols-outlined">code_blocks</span></button>
			<button id="tool-blockquote"><span class="material-symbols-outlined">format_quote</span></button>
			<button id="tool-unordered-list"><span class="material-symbols-outlined">format_list_bulleted</span></button>
			<button id="tool-ordered-list"><span class="material-symbols-outlined">format_list_numbered</span></button>

			<hr class="toolbar-separator"/>

			<button id="tool-image"><span class="material-symbols-outlined">image</span></button>
			<button id="tool-display-math"><span class="material-symbols-outlined">functions</span></button>
		</div>

		<div id="editor"></div>
	</main>

	<button class="fab" id="toggle-meta-sidebar"><span class="material-symbols-outlined toggle-close">arrow_forward</span><span class="material-symbols-outlined toggle-open">cloud_upload</span></button>

	<div class="meta-sidebar" id="meta-sidebar">
		<h3>Note Information</h3>
		<p class="input-tip">Before publishing, enter some information first!</p>

		<div class="input-wrapper">
			<span class="material-symbols-outlined input-icon">title</span>
			<label for="title">
				<span class="input-label">Title</span>
				<input type="text" placeholder="Untitled" id="title" required/>
			</label>
		</div>
		<p class="input-tip">Title will be displayed on the page and card.</p>

		<div class="input-wrapper">
			<span class="material-symbols-outlined input-icon">tag</span>
			<label for="keywords">
				<span class="input-label">Keywords</span>
				<input type="text" placeholder="" id="keywords"/>
			</label>
		</div>
		<p class="input-tip">Your note will be searchable by its keywords. Separate keywords by a space.</p>

		<div class="input-wrapper">
			<span class="material-symbols-outlined input-icon">visibility</span>
			<label for="visibility">
				<span class="input-label">Visibility</span>
				<select name="visibility" id="visibility" required>
					<option value="public" selected>Public</option>
					<option value="unlisted">Unlisted</option>
				</select>
			</label>
		</div>
		<p class="input-tip">Public means your note is searchable, unlisted means your note can only be accessed by a link.</p>

		<button id="publish"><span class="material-symbols-outlined">cloud_upload</span>Publish</button>
	</div>
</body>
</html>